{
    "name": "autoprompter",
    "displayName": "AutoPrompter",
    "description": "Automated AI prompt injection for continuous coding assistance",
    "version": "1.0.0",
    "publisher": "autoprompter",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "id": "autoPrompterSidebar",
                    "name": "AutoPrompter",
                    "when": "true"
                }
            ]
        },
        "commands": [
            {
                "command": "autoprompter.pause",
                "title": "Pause AutoPrompter",
                "icon": "$(debug-pause)"
            },
            {
                "command": "autoprompter.resume",
                "title": "Resume AutoPrompter",
                "icon": "$(debug-start)"
            },
            {
                "command": "autoprompter.sendPromptNow",
                "title": "Send Prompt Now",
                "icon": "$(send)"
            }
        ],
        "configuration": {
            "title": "AutoPrompter",
            "properties": {
                "autoprompter.schedule.intervalMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 60,
                    "description": "Minimum minutes between automated prompts"
                },
                "autoprompter.templates": {
                    "type": "array",
                    "default": [],
                    "description": "Custom prompt templates"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/glob": "^8.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.19.112",
        "@types/vscode": "^1.101.0",
        "@typescript-eslint/eslint-plugin": "^5.45.0",
        "@typescript-eslint/parser": "^5.45.0",
        "@vscode/test-electron": "^2.2.0",
        "@vscode/vsce": "^2.15.0",
        "eslint": "^8.28.0",
        "glob": "^8.0.3",
        "mocha": "^10.1.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "jsonschema": "^1.4.1"
    }
}
