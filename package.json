{
    "name": "autoprompter",
    "displayName": "AutoPrompter",
    "description": "Automated AI prompt injection for continuous coding assistance with GitHub Copilot and Cursor Chat",
    "version": "1.0.0",
    "publisher": "autoprompter",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "ai",
        "copilot",
        "cursor",
        "automation",
        "prompting",
        "assistant",
        "productivity",
        "chat",
        "coding",
        "continuous"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/autoprompter/autoprompter.git"
    },
    "homepage": "https://github.com/autoprompter/autoprompter",
    "bugs": {
        "url": "https://github.com/autoprompter/autoprompter/issues"
    },
    "license": "MIT",
    "galleryBanner": {
        "color": "#007ACC",
        "theme": "dark"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "id": "autoPrompterSidebar",
                    "name": "AutoPrompter",
                    "when": "true"
                }
            ]
        },
        "commands": [
            {
                "command": "autoprompter.pause",
                "title": "Pause AutoPrompter",
                "icon": "$(debug-pause)"
            },
            {
                "command": "autoprompter.resume",
                "title": "Resume AutoPrompter",
                "icon": "$(debug-start)"
            },
            {
                "command": "autoprompter.sendPromptNow",
                "title": "Send Prompt Now",
                "icon": "$(send)"
            }
        ],
        "configuration": {
            "title": "AutoPrompter",
            "properties": {
                "autoprompter.schedule.intervalMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 60,
                    "description": "Minimum minutes between automated prompts"
                },
                "autoprompter.templates": {
                    "type": "array",
                    "default": [],
                    "description": "Custom prompt templates"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/assert": "^1.5.11",
        "@types/glob": "^8.1.0",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.0.3",
        "@types/vscode": "^1.101.0",
        "@typescript-eslint/eslint-plugin": "^5.45.0",
        "@typescript-eslint/parser": "^5.45.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^2.15.0",
        "eslint": "^8.28.0",
        "glob": "^8.0.3",
        "mocha": "^10.1.0",
        "typescript": "^5.8.3",
        "vscode": "^1.1.34"
    },
    "dependencies": {
        "jsonschema": "^1.4.1"
    }
}
