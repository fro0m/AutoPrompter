{
    "name": "autoprompter",
    "displayName": "AutoPrompter",
    "description": "Automated AI prompt sending for GitHub Copilot Chat with minimal interval scheduling",
    "version": "1.0.0",
    "publisher": "autoprompter",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": [
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "ai",
        "copilot",
        "automation",
        "prompting",
        "assistant",
        "productivity",
        "chat",
        "coding",
        "minimal-interval"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/autoprompter/autoprompter.git"
    },
    "homepage": "https://github.com/autoprompter/autoprompter",
    "bugs": {
        "url": "https://github.com/autoprompter/autoprompter/issues"
    },
    "license": "MIT",
    "galleryBanner": {
        "color": "#007ACC",
        "theme": "dark"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "autoprompter",
                    "title": "AutoPrompter",
                    "icon": "$(robot)"
                }
            ]
        },
        "views": {
            "autoprompter": [
                {
                    "id": "autoprompter.sidebar",
                    "name": "AutoPrompter",
                    "type": "webview",
                    "when": "true"
                }
            ]
        },
        "commands": [
            {
                "command": "autoprompter.toggleAutomation",
                "title": "Toggle AutoPrompter Automation",
                "icon": "$(play)"
            },
            {
                "command": "autoprompter.executeNow",
                "title": "Execute Prompt Now",
                "icon": "$(send)"
            }
        ],
        "configuration": {
            "title": "AutoPrompter",
            "properties": {
                "autoprompter.promptText": {
                    "type": "string",
                    "default": "Please review the current code and provide suggestions for improvement.",
                    "description": "The prompt text to send to GitHub Copilot"
                },
                "autoprompter.minimalIntervalMs": {
                    "type": "number",
                    "default": 60000,
                    "minimum": 1000,
                    "maximum": 600000,
                    "description": "Minimal interval between prompts in milliseconds (1-10 minutes)"
                },
                "autoprompter.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether automation is enabled"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/assert": "^1.5.11",
        "@types/glob": "^8.1.0",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.0.3",
        "@types/vscode": "^1.95.0",
        "@typescript-eslint/eslint-plugin": "^5.45.0",
        "@typescript-eslint/parser": "^5.45.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^2.15.0",
        "eslint": "^8.28.0",
        "glob": "^8.0.3",
        "mocha": "^10.1.0",
        "typescript": "^5.8.3",
        "vscode": "^1.1.34"
    },
    "dependencies": {
        "jsonschema": "^1.4.1"
    }
}
