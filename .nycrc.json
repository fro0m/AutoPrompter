{
  "all": true,
  "include": [
    "out/src/**/*.js"
  ],
  "exclude": [
    "out/src/test/**",
    "out/src/**/*.test.js",
    "out/src/**/*.spec.js",
    "out/src/test-framework.js"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "check-coverage": true,
  "lines": 70,
  "statements": 70,
  "functions": 70,
  "branches": 60,
  "watermarks": {
    "lines": [70, 85],
    "functions": [70, 85],
    "branches": [60, 75],
    "statements": [70, 85]
  },
  "cache": true,
  "instrument": true,
  "sourceMap": true
} 